      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_qualify" bpmnElement="Task_qualify">
        <dc:Bounds x="600" y="620" width="200" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gw_qual" bpmnElement="Gw_qual">
        <dc:Bounds x="860" y="635" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="820" y="689" width="130" height="32"/>
