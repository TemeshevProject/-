<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_DevRequest" targetNamespace="http://sergek.group/product-office" exporter="Product Office">
  <bpmn:collaboration id="Collaboration_DevRequest">
    <bpmn:participant id="Participant_DevRequest" name="Запрос на разработку продукта" processRef="Process_DevRequest"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_DevRequest" name="Запрос на разработку" isExecutable="false">
    <bpmn:laneSet id="LaneSet_DevRequest">
      <bpmn:lane id="Lane_init" name="Инициатор"><bpmn:flowNodeRef>Start_need</bpmn:flowNodeRef><bpmn:flowNodeRef>Start_b2b</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_incident</bpmn:flowNodeRef><bpmn:flowNodeRef>End_support</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_card</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_fill</bpmn:flowNodeRef><bpmn:flowNodeRef>Timer_fill</bpmn:flowNodeRef><bpmn:flowNodeRef>End_autoclose</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_accept</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_accept</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_drb" name="ДРБ"><bpmn:flowNodeRef>Task_drb</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_po" name="Product Office"><bpmn:flowNodeRef>Task_qualify</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_qual</bpmn:flowNodeRef><bpmn:flowNodeRef>End_reject_qual</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_pool</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_typec</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_fast_b</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_fast_c</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_split</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_value</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_join</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_reco</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_cpo</bpmn:flowNodeRef><bpmn:flowNodeRef>Timer_postpone</bpmn:flowNodeRef><bpmn:flowNodeRef>End_reject_cpo</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_level</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_cpo</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_jira</bpmn:flowNodeRef><bpmn:flowNodeRef>Timer_post</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_post</bpmn:flowNodeRef><bpmn:flowNodeRef>End_closed</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_st" name="Sergek Technologies"><bpmn:flowNodeRef>Task_cost</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_build</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_fin" name="Финансовый департамент"><bpmn:flowNodeRef>Task_fin</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_board" name="Продуктовый совет"><bpmn:flowNodeRef>Task_board</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_board</bpmn:flowNodeRef><bpmn:flowNodeRef>End_reject_board</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ik" name="Инвестиционный комитет"><bpmn:flowNodeRef>Task_ik</bpmn:flowNodeRef><bpmn:flowNodeRef>Gw_ik</bpmn:flowNodeRef><bpmn:flowNodeRef>End_reject_ik</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_ceo" name="CEO"><bpmn:flowNodeRef>Task_order</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_need" name="Потребность в разработке"/>
    <bpmn:startEvent id="Start_b2b" name="Из процесса B2B"><bpmn:messageEventDefinition id="Msg_Start_b2b"/></bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gw_incident" name="Инцидент в продуктиве?"/>
    <bpmn:endEvent id="End_support" name="В поддержку"/>
    <bpmn:userTask id="Task_card" name="Карточка в Simbase"><bpmn:documentation>Статус «Черновик», затем «Зарегистрирован». Письмо, мессенджер и устное поручение не заменяют карточку. Обязательные поля блоков 0–3: что, зачем, как, источник финансирования, владелец со стороны бизнеса.</bpmn:documentation></bpmn:userTask>
    <bpmn:userTask id="Task_fill" name="Дозаполнить поля"><bpmn:documentation>Статус «Нужны доп. данные». Инициатор дополняет карточку. Если за 5 рабочих дней поля не закрыты, карточка закрывается автоматически.</bpmn:documentation></bpmn:userTask>
    <bpmn:boundaryEvent id="Timer_fill" name="5 рабочих дней" attachedToRef="Task_fill" cancelActivity="true"><bpmn:timerEventDefinition id="Def_Timer_fill"/></bpmn:boundaryEvent>
    <bpmn:endEvent id="End_autoclose" name="Автозакрытие"/>
    <bpmn:userTask id="Task_accept" name="Принять результат"><bpmn:documentation>Инициатор, 5 рабочих дней, статус «Выполнен».</bpmn:documentation></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_accept" name="Принято?"/>
    <bpmn:userTask id="Task_drb" name="Справка ДРБ до 15-го числа"><bpmn:documentation>До 15-го числа последнего месяца квартала: заказчики, регионы, бюджет, приоритет ДРБ, ссылки на карточки Simbase. Ответ Product Office по каждому пункту — не позже 2 недель.</bpmn:documentation></bpmn:userTask>
    <bpmn:userTask id="Task_qualify" name="Квалификация запроса"><bpmn:documentation>Intake-координатор Product Office, 2 рабочих дня. Проверяет полноту и дубли, присваивает тип A–E и трек, назначает PM. Статус «Зарегистрирован».</bpmn:documentation></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_qual" name="Итог квалификации"/>
    <bpmn:userTask id="Task_pool" name="Квартальный пул"><bpmn:documentation>Типы A, D и E ждут квартальный цикл. Резерв 5–10% ёмкости держится под ускоренный трек.</bpmn:documentation></bpmn:userTask>
    <bpmn:parallelGateway id="Gw_split" name=""/>
    <bpmn:userTask id="Task_value" name="Ценность, экономика и балл"><bpmn:documentation>PM. Сначала стоп-факторы, затем балл 0–3 по шести критериям. P1 от 2,2, P2 1,5–2,2, P3 ниже 1,5 уходит в бэклог с датой пересмотра.</bpmn:documentation></bpmn:userTask>
    <bpmn:parallelGateway id="Gw_join" name=""/>
    <bpmn:userTask id="Task_reco" name="Материалы для CPO"></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_cpo" name="Решение CPO"/>
    <bpmn:exclusiveGateway id="Gw_level" name="Уровень утверждения"/>
    <bpmn:userTask id="Task_cpo" name="Утвердить в пороге CPO"><bpmn:documentation>В проекте регламента рекомендован вариант C: до 15 млн тг и до 3 месяцев. Суммы не утверждены.</bpmn:documentation></bpmn:userTask>
    <bpmn:userTask id="Task_jira" name="Эпик Jira с номером запроса"><bpmn:documentation>PM, 2 рабочих дня. Номер запроса Simbase обязателен в эпике. Задачу без номера команда не берёт.</bpmn:documentation></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Timer_post" name="3–6 мес. после релиза"><bpmn:timerEventDefinition id="Def_Timer_post"/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_post" name="Пост-анализ"><bpmn:documentation>PM через 3–6 месяцев после релиза: факт выручки и использования против плана. Затем статус «Закрыт».</bpmn:documentation></bpmn:userTask>
    <bpmn:endEvent id="End_closed" name="Закрыт"/>
    <bpmn:exclusiveGateway id="Gw_typec" name="Тип C?"/>
    <bpmn:userTask id="Task_fast_b" name="Оценить сделку, 5 р. дней"><bpmn:documentation>Тип B, ускоренный трек, 5 рабочих дней. PM и Sergek Technologies. Подтверждение: КП, ТС, тендер или гарантийное письмо.</bpmn:documentation></bpmn:userTask>
    <bpmn:userTask id="Task_fast_c" name="Согласовать срок обязательства"><bpmn:documentation>Тип C. Решается срок исполнения, а не целесообразность. Подтверждение: договор, НПА или предписание. Трек ускоренный, утверждение всё равно по порогу.</bpmn:documentation></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Timer_postpone" name="До даты пересмотра"><bpmn:timerEventDefinition id="Def_Timer_postpone"/></bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_reject_qual" name="Отклонён"/>
    <bpmn:endEvent id="End_reject_cpo" name="Отклонён"/>
    <bpmn:userTask id="Task_cost" name="Оценить стоимость и срок"><bpmn:documentation>Sergek Technologies, R/A оценки. Полная стоимость: ФОТ × срок, оборудование, подрядчики, лицензии, сертификация. Срок анализа квартального трека — 10 рабочих дней от справки.</bpmn:documentation></bpmn:userTask>
    <bpmn:userTask id="Task_build" name="Разработка, статус раз в месяц"><bpmn:documentation>Разработка силами Sergek Technologies. PM обновляет статус в Simbase раз в месяц. Перерасход больше 20% или сдвиг срока больше 30% возвращает запрос на тот же уровень утверждения.</bpmn:documentation></bpmn:userTask>
    <bpmn:userTask id="Task_fin" name="Проверить финансирование"><bpmn:documentation>Финансовый департамент проверяет источник финансирования и экономику на горизонте 3 лет.</bpmn:documentation></bpmn:userTask>
    <bpmn:userTask id="Task_board" name="Продуктовый совет"><bpmn:documentation>Промежуточный уровень между CPO и ИК. В проекте — 15–75 млн тг или срок до 6 месяцев. Создание совета ещё не решено.</bpmn:documentation></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_board" name=""/>
    <bpmn:endEvent id="End_reject_board" name="Отклонён"/>
    <bpmn:userTask id="Task_ik" name="Инвестиционный комитет"><bpmn:documentation>Выше порога и всегда для особых категорий: новый продукт, hardware/АПК/Edge, инвестиционная разработка без заказчика больше 20 млн тг, срок больше 6 месяцев. Для ускоренного трека — внеочередное или заочное заседание.</bpmn:documentation></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_ik" name=""/>
    <bpmn:endEvent id="End_reject_ik" name="Отклонён"/>
    <bpmn:userTask id="Task_order" name="Приказ CEO о запуске"><bpmn:documentation>Для уровня ИК: согласование Project office, ДУП и бухгалтерии, подпись CEO. Как в процессе продаж B2B.</bpmn:documentation></bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_need" targetRef="Gw_incident"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Start_b2b" targetRef="Task_card"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Gw_incident" targetRef="End_support" name="да"/><bpmn:sequenceFlow id="Flow_4" sourceRef="Gw_incident" targetRef="Task_card" name="нет"/><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_card" targetRef="Task_qualify"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Task_qualify" targetRef="Gw_qual"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Gw_qual" targetRef="Task_fill" name="не хватает полей"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Task_fill" targetRef="Task_qualify" name="дозаполнено"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Timer_fill" targetRef="End_autoclose" name="срок вышел"/><bpmn:sequenceFlow id="Flow_10" sourceRef="Gw_qual" targetRef="End_reject_qual" name="дубль или стоп-фактор"/><bpmn:sequenceFlow id="Flow_11" sourceRef="Gw_qual" targetRef="Task_pool" name="A, D, E"/><bpmn:sequenceFlow id="Flow_12" sourceRef="Gw_qual" targetRef="Gw_typec" name="B или C"/><bpmn:sequenceFlow id="Flow_13" sourceRef="Task_pool" targetRef="Task_drb"/><bpmn:sequenceFlow id="Flow_14" sourceRef="Task_drb" targetRef="Gw_split"/><bpmn:sequenceFlow id="Flow_15" sourceRef="Gw_split" targetRef="Task_value"/><bpmn:sequenceFlow id="Flow_16" sourceRef="Gw_split" targetRef="Task_cost"/><bpmn:sequenceFlow id="Flow_17" sourceRef="Gw_split" targetRef="Task_fin"/><bpmn:sequenceFlow id="Flow_18" sourceRef="Task_value" targetRef="Gw_join"/><bpmn:sequenceFlow id="Flow_19" sourceRef="Task_cost" targetRef="Gw_join"/><bpmn:sequenceFlow id="Flow_20" sourceRef="Task_fin" targetRef="Gw_join"/><bpmn:sequenceFlow id="Flow_21" sourceRef="Gw_join" targetRef="Task_reco"/><bpmn:sequenceFlow id="Flow_22" sourceRef="Gw_typec" targetRef="Task_fast_c" name="обязательство"/><bpmn:sequenceFlow id="Flow_23" sourceRef="Gw_typec" targetRef="Task_fast_b" name="сделка"/><bpmn:sequenceFlow id="Flow_24" sourceRef="Task_fast_c" targetRef="Task_reco"/><bpmn:sequenceFlow id="Flow_25" sourceRef="Task_fast_b" targetRef="Task_reco"/><bpmn:sequenceFlow id="Flow_26" sourceRef="Task_reco" targetRef="Gw_cpo"/><bpmn:sequenceFlow id="Flow_27" sourceRef="Gw_cpo" targetRef="Task_fill" name="нужны данные"/><bpmn:sequenceFlow id="Flow_28" sourceRef="Gw_cpo" targetRef="End_reject_cpo" name="отклонить"/><bpmn:sequenceFlow id="Flow_29" sourceRef="Gw_cpo" targetRef="Timer_postpone" name="отложить"/><bpmn:sequenceFlow id="Flow_30" sourceRef="Timer_postpone" targetRef="Task_pool"/><bpmn:sequenceFlow id="Flow_31" sourceRef="Gw_cpo" targetRef="Gw_level" name="на утверждение"/><bpmn:sequenceFlow id="Flow_32" sourceRef="Gw_level" targetRef="Task_cpo" name="порог CPO"/><bpmn:sequenceFlow id="Flow_33" sourceRef="Gw_level" targetRef="Task_board" name="Продсовет"/><bpmn:sequenceFlow id="Flow_34" sourceRef="Gw_level" targetRef="Task_ik" name="ИК"/><bpmn:sequenceFlow id="Flow_35" sourceRef="Task_cpo" targetRef="Task_jira"/><bpmn:sequenceFlow id="Flow_36" sourceRef="Task_board" targetRef="Gw_board"/><bpmn:sequenceFlow id="Flow_37" sourceRef="Gw_board" targetRef="Task_jira" name="утверждён"/><bpmn:sequenceFlow id="Flow_38" sourceRef="Gw_board" targetRef="End_reject_board" name="отклонён"/><bpmn:sequenceFlow id="Flow_39" sourceRef="Task_ik" targetRef="Gw_ik"/><bpmn:sequenceFlow id="Flow_40" sourceRef="Gw_ik" targetRef="Task_order" name="утверждён"/><bpmn:sequenceFlow id="Flow_41" sourceRef="Gw_ik" targetRef="End_reject_ik" name="отклонён"/><bpmn:sequenceFlow id="Flow_42" sourceRef="Task_order" targetRef="Task_jira"/><bpmn:sequenceFlow id="Flow_43" sourceRef="Task_jira" targetRef="Task_build"/><bpmn:sequenceFlow id="Flow_44" sourceRef="Task_build" targetRef="Task_accept"/><bpmn:sequenceFlow id="Flow_45" sourceRef="Task_accept" targetRef="Gw_accept"/><bpmn:sequenceFlow id="Flow_46" sourceRef="Gw_accept" targetRef="Task_build" name="замечания"/><bpmn:sequenceFlow id="Flow_47" sourceRef="Gw_accept" targetRef="Timer_post" name="принято"/><bpmn:sequenceFlow id="Flow_48" sourceRef="Timer_post" targetRef="Task_post"/><bpmn:sequenceFlow id="Flow_49" sourceRef="Task_post" targetRef="End_closed"/>
    <bpmn:textAnnotation id="Note_stop">
      <bpmn:text>Стоп-факторы: продукт в категории «Закрытие»; нет источника финансирования; нет владельца со стороны бизнеса; функция уже есть или закрывается конфигурацией, партнёром, интеграцией.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_stop" sourceRef="Task_qualify" targetRef="Note_stop"/>
    <bpmn:textAnnotation id="Note_threshold">
      <bpmn:text>Пороги на схеме — рекомендованный вариант C, он ещё не утверждён: CPO до 15 млн тг и 3 мес.; Продсовет 15–75 млн или до 6 мес.; ИК выше 75 млн и особые категории.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_threshold" sourceRef="Gw_level" targetRef="Note_threshold"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_DevRequest">
    <bpmndi:BPMNPlane id="Plane_DevRequest" bpmnElement="Collaboration_DevRequest">
      <bpmndi:BPMNShape id="Shape_Participant" bpmnElement="Participant_DevRequest" isHorizontal="true">
        <dc:Bounds x="40" y="56" width="4390" height="1880"/>
      </bpmndi:BPMNShape>
